datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

// ================= ENUMS =================
enum UserRole {
  student
  teacher
  admin
}

enum ModerationStatus {
  published
  pending
  hidden
}

enum TargetType {
  post
  comment
}

enum NotificationType {
  comment
  reply
  vote
  system
  moderation
  report
}

enum ReportStatus {
  open
  resolved
}

enum ModerationResolveAction {
  keep
  warn
  delete
}

enum BannedWordAction {
  pending
  hidden
}

enum TagCategory {
  subject
  class
  faculty
  field
  other
}

enum PostDifficulty {
  easy
  medium
  hard
}

enum ConversationStatus {
  pending
  active
}

// ================= MODELS =================

model User {
  id                     Int       @id @default(autoincrement())
  email                  String    @unique @db.VarChar(255)
  username               String    @unique @db.VarChar(100)
  password_hash          String    @db.VarChar(255)
  full_name              String    @db.VarChar(150)
  avatar_url             String?   @db.Text
  birthday               DateTime?
  bio                    String?   @db.Text
  social_links           Json?
  faculty                String?   @db.VarChar(150)
  role                   UserRole  @default(student)
  is_active              Boolean   @default(true)
  reward_points          Int       @default(200)
  reset_password_token   String?   @db.VarChar(255)
  reset_password_expires DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  // Quan hệ (Relations)
  posts              Post[]
  post_ratings       PostRating[]
  reward_redemptions RewardRedemption[]
  comments           Comment[]
  votes              Vote[]
  notifications      Notification[]       @relation("UserNotifications")
  sent_notifications Notification[]       @relation("SenderNotifications")
  refresh_tokens     RefreshToken[]
  banned_words       BannedWord[]
  reports_submitted  ContentReport[]      @relation("Reporter")
  reports_resolved   ContentReport[]      @relation("Resolver")
  moderation_logs    ModerationAuditLog[]
  post_follows       PostFollow[]

  followings UserFollow[] @relation("Followers")
  followers  UserFollow[] @relation("Followings")

  // Chat relations
  conversations1  Conversation[] @relation("ConversationUser1")
  conversations2  Conversation[] @relation("ConversationUser2")
  initiated_chats Conversation[] @relation("ConversationInitiator")
  sent_messages   Message[]

  // Password history
  password_histories PasswordHistory[]

  @@index([role])
  @@index([is_active])
  @@index([faculty])
  @@map("users")
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model PasswordHistory {
  id            Int      @id @default(autoincrement())
  user_id       Int
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([created_at])
  @@map("password_histories")
}

model Post {
  id                  Int              @id @default(autoincrement())
  author_id           Int
  title               String           @db.VarChar(255)
  slug                String           @unique @db.VarChar(255)
  excerpt             String?          @db.VarChar(500)
  content             String           @db.Text
  moderation_status   ModerationStatus @default(published)
  moderation_note     String?          @db.Text
  matched_words       Json?
  view_count          Int              @default(0)
  answer_count        Int              @default(0)
  bounty              Int              @default(0)
  difficulty          PostDifficulty   @default(medium)
  avg_rating          Float            @default(0)
  rating_count        Int              @default(0)
  accepted_comment_id Int?             @unique
  vote_score          Int              @default(0)
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  deleted_at          DateTime?

  // Quan hệ (Relations)
  author           User           @relation(fields: [author_id], references: [id])
  accepted_comment Comment?       @relation("AcceptedComment", fields: [accepted_comment_id], references: [id], onDelete: SetNull)
  comments         Comment[]      @relation("PostComments")
  post_tags        PostTag[]
  notifications    Notification[]
  post_follows     PostFollow[]
  ratings          PostRating[]

  @@index([difficulty])
  @@index([avg_rating])
  @@index([author_id])
  @@index([moderation_status])
  @@index([created_at])
  @@index([moderation_status, created_at])
  @@index([deleted_at])
  @@index([bounty])
  @@fulltext([title, content])
  @@map("posts")
}

model PostFollow {
  user_id    Int
  post_id    Int
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@id([user_id, post_id])
  @@index([user_id, created_at])
  @@index([post_id])
  @@map("post_follows")
}

model Tag {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(100)
  slug        String      @unique @db.VarChar(100)
  category    TagCategory @default(other)
  description String?     @db.VarChar(255)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  post_tags PostTag[]

  @@index([category])
  @@map("tags")
}

model PostTag {
  post_id    Int
  tag_id     Int
  created_at DateTime @default(now())

  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([post_id, tag_id])
  @@index([tag_id])
  @@map("post_tags")
}

model Comment {
  id                Int              @id @default(autoincrement())
  post_id           Int
  author_id         Int
  parent_id         Int?
  content           String           @db.Text
  is_accepted       Boolean          @default(false)
  moderation_status ModerationStatus @default(published)
  moderation_note   String?          @db.Text
  matched_words     Json?
  vote_score        Int              @default(0)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  deleted_at        DateTime?

  // Quan hệ (Relations)
  post              Post           @relation("PostComments", fields: [post_id], references: [id], onDelete: Cascade)
  author            User           @relation(fields: [author_id], references: [id])
  accepted_for_post Post?          @relation("AcceptedComment")
  parent            Comment?       @relation("ReplyToComment", fields: [parent_id], references: [id], onDelete: Cascade)
  replies           Comment[]      @relation("ReplyToComment")
  notifications     Notification[]

  @@index([post_id])
  @@index([author_id])
  @@index([parent_id])
  @@index([post_id, parent_id, created_at])
  @@index([moderation_status])
  @@index([deleted_at])
  @@map("comments")
}

model Vote {
  id          Int        @id @default(autoincrement())
  user_id     Int
  target_id   Int
  target_type TargetType
  vote_value  Int        @db.TinyInt
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, target_id, target_type])
  @@index([target_type, target_id])
  @@map("votes")
}

model Notification {
  id         Int              @id @default(autoincrement())
  user_id    Int
  sender_id  Int?
  post_id    Int?
  comment_id Int?
  type       NotificationType
  title      String?          @db.VarChar(150)
  content    String           @db.VarChar(500)
  link_path  String?          @db.VarChar(255)
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  // Quan hệ (Relations)
  user    User     @relation("UserNotifications", fields: [user_id], references: [id], onDelete: Cascade)
  sender  User?    @relation("SenderNotifications", fields: [sender_id], references: [id], onDelete: SetNull)
  post    Post?    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at])
  @@index([user_id])
  @@map("notifications")
}

model BannedWord {
  id         Int              @id @default(autoincrement())
  word       String           @unique @db.VarChar(100)
  action     BannedWordAction @default(pending)
  created_by Int?
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  creator User? @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@map("banned_words")
}

model ContentReport {
  id              Int                      @id @default(autoincrement())
  target_type     TargetType
  target_id       Int
  reporter_id     Int
  reason          String                   @db.VarChar(1000)
  status          ReportStatus             @default(open)
  resolved_action ModerationResolveAction?
  resolved_by     Int?
  resolved_at     DateTime?
  created_at      DateTime                 @default(now())
  updated_at      DateTime                 @updatedAt

  reporter   User                 @relation("Reporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  resolver   User?                @relation("Resolver", fields: [resolved_by], references: [id], onDelete: SetNull)
  audit_logs ModerationAuditLog[]

  @@index([status])
  @@index([target_type, target_id])
  @@index([reporter_id, target_type, target_id, status])
  @@index([created_at])
  @@map("content_reports")
}

model PostRating {
  id         Int      @id @default(autoincrement())
  post_id    Int
  user_id    Int
  stars      Int      @db.TinyInt
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@index([user_id])
  @@map("post_ratings")
}

model RewardItem {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  cost        Int
  stock       Int      @default(100)
  active      Boolean  @default(true)
  created_at  DateTime @default(now())

  redemptions RewardRedemption[]

  @@map("reward_items")
}

model RewardRedemption {
  id           Int      @id @default(autoincrement())
  user_id      Int
  item_id      Int
  cost         Int
  voucher_code String?  @db.VarChar(100)
  is_used      Boolean  @default(false)
  created_at   DateTime @default(now())

  user User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  item RewardItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("reward_redemptions")
}

model ModerationAuditLog {
  id              Int               @id @default(autoincrement())
  actor_id        Int
  target_type     TargetType
  target_id       Int
  action          String            @db.VarChar(50)
  previous_status ModerationStatus?
  new_status      ModerationStatus?
  note            String?           @db.Text
  report_id       Int?
  created_at      DateTime          @default(now())

  actor  User           @relation(fields: [actor_id], references: [id], onDelete: Cascade)
  report ContentReport? @relation(fields: [report_id], references: [id], onDelete: SetNull)

  @@index([target_type, target_id])
  @@index([actor_id])
  @@index([created_at])
  @@map("moderation_audit_logs")
}

model UserFollow {
  follower_id  Int
  following_id Int
  created_at   DateTime @default(now())

  follower  User @relation("Followers", fields: [follower_id], references: [id], onDelete: Cascade)
  following User @relation("Followings", fields: [following_id], references: [id], onDelete: Cascade)

  @@id([follower_id, following_id])
  @@index([following_id, created_at(sort: Desc)])
  @@index([follower_id, created_at(sort: Desc)])
  @@map("user_follows")
}

model Conversation {
  id              Int                @id @default(autoincrement())
  user1_id        Int
  user2_id        Int
  initiated_by_id Int?
  status          ConversationStatus @default(active)
  accepted_at     DateTime?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  user1        User      @relation("ConversationUser1", fields: [user1_id], references: [id], onDelete: Cascade)
  user2        User      @relation("ConversationUser2", fields: [user2_id], references: [id], onDelete: Cascade)
  initiated_by User?     @relation("ConversationInitiator", fields: [initiated_by_id], references: [id], onDelete: SetNull)
  messages     Message[]

  @@unique([user1_id, user2_id])
  @@index([user1_id])
  @@index([user2_id])
  @@map("conversations")
}

model Message {
  id              Int      @id @default(autoincrement())
  conversation_id Int
  sender_id       Int
  content         String   @db.Text
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([sender_id])
  @@map("messages")
}
